{
  "name": "@primitivekit/svelte",
  "version": "0.0.3",
  "description": "Primitive Svelte components with zero hardcoded values. Fully customizable via CSS variables.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "svelte": "dist/index.js",
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": {
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.js",
      "types": "./dist/tokens/index.d.ts"
    },
    "./tokens/tokens.css": "./dist/tokens/tokens.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'Build placeholder - Svelte components ready for use'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "components",
    "ui",
    "customizable",
    "accessible",
    "css-variables"
  ],
  "author": "PrimitiveKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/primitivekit/svelte"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.0.0",
    "svelte": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
